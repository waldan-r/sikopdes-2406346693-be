{
  "info": {
    "name": "SIKopDes KD5 — REST API",
    "description": "Jalankan berurutan melalui Collection Runner. Request tambah/ubah/bayar mengubah data aplikasi, lalu menutup plafon percobaan di akhir alur. PDF dan tabel interaktif diuji melalui web.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "anggotaId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const jakarta = new Date(Date.now() + 7 * 60 * 60 * 1000);",
          "const transaction = new Date(jakarta.getTime() - 60 * 1000);",
          "const due = new Date(jakarta.getTime() + 3 * 24 * 60 * 60 * 1000);",
          "pm.collectionVariables.set(\"tanggalTransaksi\", transaction.toISOString().slice(0, 19));",
          "pm.collectionVariables.set(\"tanggalBayar\", jakarta.toISOString().slice(0, 10));",
          "pm.collectionVariables.set(\"tanggalJatuhTempo\", due.toISOString().slice(0, 10));",
          "pm.collectionVariables.set(\"tahun\", jakarta.getUTCFullYear());"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 · Ringkasan beranda",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/dashboard"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test(\"Response envelope\", () => { pm.expect(result.status).to.eql(200); pm.expect(result).to.have.all.keys(\"status\", \"message\", \"timestamp\", \"data\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 · Anggota",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/anggota"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test(\"Response envelope\", () => { pm.expect(result.status).to.eql(200); pm.expect(result).to.have.all.keys(\"status\", \"message\", \"timestamp\", \"data\"); });",
              "pm.collectionVariables.set(\"members\", JSON.stringify(result.data));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 · Daftar plafon dan pilih anggota yang belum memiliki plafon",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/plafon"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test(\"Response envelope\", () => { pm.expect(result.status).to.eql(200); pm.expect(result).to.have.all.keys(\"status\", \"message\", \"timestamp\", \"data\"); });",
              "const members = JSON.parse(pm.collectionVariables.get(\"members\"));",
              "const free = members.find(a => a.statusKeanggotaan === \"Aktif\" && !result.data.some(p => p.anggotaId === a.id && p.status !== \"Ditutup\"));",
              "pm.test(\"Ada anggota yang memenuhi syarat\", () => pm.expect(free).to.exist);",
              "if (free) pm.collectionVariables.set(\"anggotaId\", free.id);"
            ]
          }
        }
      ]
    },
