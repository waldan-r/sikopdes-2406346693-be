              "pm.test(\"Response envelope\", () => { pm.expect(result.status).to.eql(201); pm.expect(result).to.have.all.keys(\"status\", \"message\", \"timestamp\", \"data\"); });",
              "pm.collectionVariables.set(\"plafonId\",result.data.id);"
